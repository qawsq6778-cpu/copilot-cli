<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>متع عقلك</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      direction: rtl;
      margin: 0;
      background: #f5f5f5;
    }

    header {
      background: #4a148c;
      color: white;
      padding: 20px;
      text-align: center;
    }

    .books {
      display: flex;
      gap: 15px;
      padding: 15px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .book-card {
      background: white;
      width: 220px;
      padding: 10px;
      border-radius: 8px;
      text-align: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .book-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 5px;
    }

    button {
      background: #25D366;
      color: white;
      border: none;
      padding: 10px;
      width: 100%;
      border-radius: 5px;
      font-size: 16px;
      cursor: pointer;
    }

    footer {
      background: #eee;
      text-align: center;
      padding: 10px;
      margin-top: 20px;
    }
  </style>
</head>

<body>

<header>
  <h1>متع عقلك</h1>
  <p>بيع الكتب الورقية | قصص وروايات</p>
</header>

<main>
  <section class="books">

    <div class="book-card">
      <img src="book1.jpg" alt="اسم الكتاب 1">
      <h3>اسم الكتاب 1</h3>
      <p>وصف قصير للكتاب</p>
      <button onclick="buyBook( اسم الكتاب 1 )">شراء الكتاب</button>
    </div>

    <div class="book-card">
      <img src="book2.jpg" alt="اسم الكتاب 2">
      <h3>اسم الكتاب 2</h3>
      <p>وصف قصير للكتاب</p>
      <button onclick="buyBook( اسم الكتاب 2 )">شراء الكتاب</button>
    </div>

  </section>
</main>

<footer>
  <p>جميع الحقوق محفوظة © متع عقلك</p>
</footer>

<script>
  function buyBook(bookName) {
    const phone = "967735600048"; 
    const message = `السلام عليكم، أريد شراء كتاب: ${bookName}`;
    window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`);
  }
</script>

</body>
</html>
